# Copy to .env and adjust. docker compose reads this file automatically.
# The defaults below match docker-compose.yml, so .env is optional locally.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=policy_navigator

# A backend run outside Docker (uvicorn from backend/) already defaults to
# localhost:5432 with these credentials; override DATABASE_URL in backend/.env
# only if yours differ.

# Frontend: TEMPORARY fake sign-in (frontend/src/auth/fakeAuth.ts) until the
# backend auth endpoints land. "true" accepts researcher1 and admin1 without
# calling the API; the session lives in memory, so a reload signs you out.
# Outside Docker: VITE_FAKE_AUTH=true npm run dev (from frontend/).
VITE_FAKE_AUTH=false
