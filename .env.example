# Copy to .env and adjust. docker compose reads this file automatically.
# The defaults below match docker-compose.yml, so .env is optional locally.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=policy_navigator

# A backend run outside Docker (uvicorn from backend/) already defaults to
# localhost:5432 with these credentials; override DATABASE_URL in backend/.env
# only if yours differ.

# Auth (docs/auth.md). "mock" lets you sign in as any Onyen, e.g. researcher1 or
# admin1 from the seed data. Only "mock" exists until UNC SSO access is granted.
AUTH_PROVIDER=mock
# Signs the session cookie. The built-in default is for local use only; production
# refuses to start without a real value (generate one with: openssl rand -hex 32).
# SESSION_SECRET=
